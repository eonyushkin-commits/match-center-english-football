{
  "name": "match-center-english-football",
  "productName": "Матч-центр",
  "version": "2.2.3",
  "description": "Матч-центр по английскому футболу: расписание FotMob и трансляции из VK Видео",
  "main": "src/electron/main.cjs",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node scripts/electron.mjs .",
    "start": "node src/cli.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "icon": "node scripts/electron.mjs scripts/make-icon.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.sportcenter.matchcenter",
    "productName": "Матч-центр",
    "files": [
      "src/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "match-center-${version}-setup.${ext}",
      "shortcutName": "Матч-центр"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eonyushkin-commits",
        "repo": "match-center-english-football"
      }
    ]
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "electron-winstaller@5.4.0": true
  }
}
